{% extends 'base.html.twig' %}

{% block title %}{{ cuenta.codigo }}{% endblock %}

{% block body %}
    <h1>{{ cuenta.codigo }} <span class="badge badge-{{ cuenta.estado }}">{{ cuenta.estado }}</span></h1>

    <div class="detalle">
        <dl>
            <dt>Cliente</dt><dd>{{ cuenta.cliente.nombre }}</dd>
            <dt>Vencimiento</dt><dd>{{ cuenta.getVencimiento ? cuenta.vencimiento|date('d/m/Y') : '-' }}</dd>
            <dt>Total</dt><dd>{{ cuenta.moneda }} {{ cuenta.total|number_format(2) }}</dd>
            <dt>Saldo</dt><dd>{{ cuenta.moneda }} {{ cuenta.saldo|number_format(2) }}</dd>
        </dl>
    </div>

    <h3>Conceptos</h3>
    <table>
        <thead>
            <tr><th>Tipo</th><th>Descripcion</th><th>Cantidad</th><th>Precio</th><th>Descuento</th><th>Neto</th></tr>
        </thead>
        <tbody>
            {% for concepto in cuenta.conceptos %}
                <tr>
                    <td>{{ concepto.tipo }}</td>
                    <td>{{ concepto.descripcion }}</td>
                    <td>{{ concepto.cantidad }}</td>
                    <td>{{ concepto.precio|number_format(2) }}</td>
                    <td>{{ concepto.descuento|number_format(2) }}</td>
                    <td>{{ concepto.neto|number_format(2) }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <h3>Pagos aplicados</h3>
    <table>
        <thead>
            <tr><th>Referencia</th><th>Proveedor</th><th>Recibido</th><th>Aplicado</th><th>Exceso</th><th>Fecha</th><th>Verificación</th></tr>
        </thead>
        <tbody>
            {% for aplicacion in cuenta.aplicaciones %}
                <tr>
                    <td>{{ aplicacion.referencia }}</td>
                    <td>{{ aplicacion.proveedor }}</td>
                    <td>{{ aplicacion.importeRecibido|number_format(2) }}</td>
                    <td>{{ aplicacion.importeAplicado|number_format(2) }}</td>
                    <td>{{ aplicacion.exceso|number_format(2) }}</td>
                    <td>{{ aplicacion.verificadoEn|date('d/m/Y H:i') }}</td>
                    <td>{% if aplicacion.esSimulada() %}<strong>SIMULADO</strong>{% else %}REAL{% endif %}</td>
                </tr>
            {% else %}
                <tr><td colspan="7">todavia no se registraron pagos</td></tr>
            {% endfor %}
        </tbody>
    </table>

    {% if cuenta.estado == 'pendiente' and app.environment != 'prod' %}
        <h3>Registrar pago</h3>
        <form class="form-card" method="post" action="{{ path('cuenta_pago', { id: cuenta.id }) }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
            <label for="referencia">Referencia del movimiento</label>
            <input id="referencia" name="referencia" required>
            <label for="proveedor">Proveedor / banco</label>
            <input id="proveedor" name="proveedor" value="transferencia" required>
            <p class="alerta">Modo desarrollo: esta operación simula la pasarela y no constituye una verificación real.</p>
            <label for="importe">Importe de prueba para la simulación</label>
            <input id="importe" name="importe" type="number" step="0.01" required>
            <button class="boton" type="submit">Simular verificación y aplicar</button>
        </form>
    {% endif %}

    {% if cuenta.devoluciones|length > 0 %}
        <h3>Devoluciones por exceso</h3>
        <table>
            <thead>
                <tr><th>Monto</th><th>Estado</th><th>Autorizado por</th><th>Referencia salida</th><th></th></tr>
            </thead>
            <tbody>
                {% for devolucion in cuenta.devoluciones %}
                    <tr>
                        <td>{{ devolucion.monto|number_format(2) }}</td>
                        <td>{{ devolucion.estado }}</td>
                        <td>{{ devolucion.autorizadoPor ?: '-' }}</td>
                        <td>{{ devolucion.referenciaSalida ?: '-' }}{% if devolucion.esSimulada() %} (SIMULADA){% endif %}</td>
                        <td>
                            {% if devolucion.estado == 'pendiente' %}
                                <form class="inline" method="post" action="{{ path('cuenta_devolucion_aprobar', { id: cuenta.id, devolucionId: devolucion.id }) }}">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                                    <input name="autorizadoPor" placeholder="Direccion" required style="width: 120px">
                                    <button class="boton secundario" type="submit">Aprobar</button>
                                </form>
                            {% elseif devolucion.estado == 'aprobada' and app.environment != 'prod' %}
                                <form class="inline" method="post" action="{{ path('cuenta_devolucion_confirmar', { id: cuenta.id, devolucionId: devolucion.id }) }}">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                                    <button class="boton secundario" type="submit">Simular devolución</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if cuenta.estado == 'saldada' %}
        <form method="post" action="{{ path('factura_preparar', { cuentaId: cuenta.id }) }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
            <button class="boton" type="submit">Preparar factura</button>
        </form>
    {% endif %}
{% endblock %}
