{% extends 'base.html.twig' %}

{% block title %}Liquidar cuenta{% endblock %}

{% block body %}
    <h1>Liquidar cuenta</h1>
    <form class="form-card" method="post" action="{{ path('cuenta_new') }}" data-controller="conceptos" style="max-width: 820px">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">

        <label for="cliente">Cliente</label>
        <select id="cliente" name="cliente" required>
            <option value="">selecciona un cliente</option>
            {% for cliente in clientes %}
                <option value="{{ cliente.id }}">{{ cliente.nombre }} ({{ cliente.plan }})</option>
            {% endfor %}
        </select>

        <label for="periodo">Periodo (opcional)</label>
        <input id="periodo" name="periodo" placeholder="2026-11">

        <label for="vencimiento">Vencimiento (opcional)</label>
        <input id="vencimiento" name="vencimiento" type="date">

        <h3>Conceptos</h3>
        <div data-conceptos-target="filas">
            <div class="fila-concepto">
                <select name="tipo[]">
                    <option value="cuota">Cuota</option>
                    <option value="hora_adicional">Hora adicional</option>
                    <option value="alquiler">Alquiler de sala</option>
                    <option value="cancelacion">Cancelacion tardia</option>
                    <option value="deposito">Deposito de evento</option>
                    <option value="servicio_extra">Servicio extra</option>
                </select>
                <input name="descripcion[]" placeholder="descripcion">
                <input name="cantidad[]" type="number" step="0.01" value="1" placeholder="cantidad">
                <input name="precio[]" type="number" step="0.01" placeholder="precio">
                <input name="descuento[]" type="number" step="0.01" value="0" placeholder="descuento">
            </div>
        </div>

        <template data-conceptos-target="plantilla">
            <div class="fila-concepto">
                <select name="tipo[]">
                    <option value="cuota">Cuota</option>
                    <option value="hora_adicional">Hora adicional</option>
                    <option value="alquiler">Alquiler de sala</option>
                    <option value="cancelacion">Cancelacion tardia</option>
                    <option value="deposito">Deposito de evento</option>
                    <option value="servicio_extra">Servicio extra</option>
                </select>
                <input name="descripcion[]" placeholder="descripcion">
                <input name="cantidad[]" type="number" step="0.01" value="1" placeholder="cantidad">
                <input name="precio[]" type="number" step="0.01" placeholder="precio">
                <input name="descuento[]" type="number" step="0.01" value="0" placeholder="descuento">
            </div>
        </template>

        <p>
            <button class="boton secundario" type="button" data-action="conceptos#agregar">+ agregar concepto</button>
        </p>

        <button class="boton" type="submit">Liquidar cuenta</button>
    </form>
{% endblock %}
